# Variables de entorno (desarrollo) de CoLabora 
# Uso: copiar este archivo a `.env` (cp .env.example .env).

# Base de Espacios (contenedor espacios-db) ----

# Usuario que crea PostgreSQL al inicializar la base
ESPACIOS_DB_USUARIO=espacios
# Contraseña de ese usuario 
ESPACIOS_DB_PASSWORD=espacios_dev
# Nombre de la base de datos
ESPACIOS_DB_NOMBRE=espacios


# Espacios (servidor gRPC) -----

# Puerto en el que escucha el servidor gRPC
ESPACIOS_PUERTO_GRPC=50051
# Retardo agregado a cada RPC, en milisegundos (0 = sin retardo; se usara en experimentos)
ESPACIOS_LATENCIA_ARTIFICIAL_MS=0
# Zona horaria con la que se interpretan fechas y franjas
ESPACIOS_ZONA_HORARIA=America/Santiago

# Base de Reservas (contenedor reservas-db)

# Usuario que crea PostgreSQL al inicializar la base
RESERVAS_DB_USUARIO=reservas
# Contraseña de ese usuario 
RESERVAS_DB_PASSWORD=reservas_dev
# Nombre de la base de datos
RESERVAS_DB_NOMBRE=reservas


# Reservas (API REST)

# Dirección del servidor gRPC de Espacios (host:puerto)
ESPACIOS_DIRECCION=espacios:50051
# Tiempo máximo de espera de cada llamada a Espacios, en milisegundos
ESPACIOS_DEADLINE_MS=1000


# Seguridad

# Secreto para firmar los JWT. CAMBIARLO fuera de desarrollo
JWT_SECRETO=cambiar-este-secreto-en-produccion
# Duración de cada token, en minutos
JWT_MINUTOS_VALIDEZ=60
# Email del administrador que se crea al arrancar Reservas si no existe ninguno
ADMIN_EMAIL_INICIAL=admin@example.com
# Contraseña de ese administrador 
ADMIN_PASSWORD_INICIAL=admin_dev_123


# Redis (caché de disponibilidad)

# URL de conexión a Redis dentro de la red de Docker
REDIS_URL=redis://redis:6379/0
# Vencimiento de la grilla en caché, en segundos (0 = caché desactivada)
CACHE_TTL_SEGUNDOS=30
